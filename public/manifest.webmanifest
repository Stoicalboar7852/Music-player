{
  "name": "Phosphor",
  "short_name": "Phosphor",
  "description": "A music player whose main attraction is its visualizers.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["fullscreen", "standalone"],
  "orientation": "any",
